$C = "../../Common.ui";
$C.@PageOverlay {}
Group{
    LayoutMode:Center;
      $C.@Container #SettingsPanel {
            Anchor: (Width: 400, Height: 500,Right:10);
            #Title {
              $C.@Title { @Text = %RedCrystal.ui.settings.title; }
            }
            #Content {
                LayoutMode:Top;
                Group #Main {
                    LayoutMode:Top;
                }
            }
      }
}


