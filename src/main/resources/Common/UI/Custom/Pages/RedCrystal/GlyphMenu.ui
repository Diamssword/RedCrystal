$C = "../../Common.ui";

$C.@PageOverlay {}
Group {
    LayoutMode: Center;
        //Left Panels
    Group {
        LayoutMode: Top;
        Anchor: (Height:500);

        //TOP panel
        $C.@DecoratedContainer {
            Padding: (Right: 15);
            Anchor: (Width: 300, Height: 250);
            #Title {
              $C.@Title { @Text = "Selected"; }
            }
            #Content {
                Group #SelectedRune {
                    LayoutMode: Top;
                    $C.@Title #SelectedTitle {
                        @Text = "";
                    }
                    Group {
                        Padding:(Left: 10,Right: 10,Top:10);
                        LayoutMode: Top;
                        Anchor:(Width: 280,Height: 130);
                        AssetImage #SelectedImage {
                            Anchor:(Width: 100,Height: 100);
                          Padding:(Bottom:10);
                        }
                        $C.@SmallSecondaryTextButton #GlyphSettingsBt {
                          @Text = "Settings";
                        }
                    }
                }
            }
        }
        //Bottom panel
        $C.@Container {
               Padding: (Right: 15);
               Anchor: (Width: 300, Height: 250);
                #Title {
                    $C.@Title { @Text = "Global Settings"; }
                }
                #Content {
                    Group #MainSettings {
                        LayoutMode: Top;
                    }
                }
        }
    }
    //Center Panel
    $C.@DecoratedContainer {

        Anchor:(Width: 580, Height: 500);
         #Title {
            Group {
                $C.@Title { @Text = "Glyph selector"; }
                $C.@HeaderSearch #Search {}
            }
         }
         #Content {
            Group #GlyphContainer {
                LayoutMode: TopScrolling;

            }
         }
    }
     //Right Panel
       $C.@DecoratedContainer {
                 Padding: (Left: 15);
                 Anchor: (Width: 400, Height: 500);
                 #Title {
                   $C.@Title { @Text = "Description"; }
                 }
                 #Content {
                    LayoutMode: Top;
                    Group {
                        LayoutMode: Left;
                        Anchor:(Left: 0,Width: 80);
                        Background: (TexturePath:"../../Common/DropdownPressed.png");
                        Label #HoveredType {
                            Padding: (Left:5);
                            Text:"Sigil";
                        }
                    }
                    $C.@Title #HoveredTitle { @Text = "Glyph"; }
                    Group {
                        LayoutMode: TopScrolling;
                        Anchor: (Width: 380,Height: 400);
                         AssetImage #HoveredImage {
                            Anchor:(Width: 150,Height: 150);
                            Padding: (Left:25,Top: 10,Bottom:10 );
                         }
                         Group {
                            Padding: (Left: 30);
                            Anchor: (Width: 380);
                            LayoutMode: Top;
                            Label #HoveredIO {
                                Text:"Inputs: 1 | Outputs: 2";
                                Style: (HorizontalAlignment:Center);
                            }
                            Label #HoveredDesc {
                                Text:"A long ass description of what the rune might do in the close future";
                                Background:(TexturePath:"../../Common/TooltipDefaultBackground.png", Border: 24);
                                Padding: 24;
                                Style: (Wrap:true);
                            }
                         }
                    }
                 }
             }
}
