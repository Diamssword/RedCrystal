# === Items ===
items.staff.name=Glyph Carver
items.staff.desc=A powerful tool used to carve red glyphs on walls \nUse [Ability 1] to select the glyph\nUse [Primary Action] to place glyph or edit settings\nUse [Secondary Action] to remove glyphs or links
items.sliver.name=Red Crystal Sliver
items.sliver.desc=Slowly Replenish Any Glyph Carver with missing durability in your hotbar and get consumed in the process

