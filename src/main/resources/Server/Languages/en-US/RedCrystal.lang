# === InteractionHints ===
interactionHints.input=Input\nLeft Click to create link\nRight Click to break link
interactionHints.output=Output\nLeft Click to create link\nRight Click to break link
glyph.Interact.name=Interactor
glyph.Interact.desc=An element that can interact with blocks the same way a player can, you can open doors, toggle lights, etc.

# === Glyphs ===

# Inputs
glyph.Button.name=Button
glyph.Button.desc=A button that send a pulse signal when pressed
glyph.PressurePlate.name=Pressure Plate
glyph.PressurePlate.desc=Trigger when an entity collide with it
glyph.Lever.name=Lever
glyph.Lever.desc=Allow to manually toggle between ON and OFF signal
glyph.Variator.name=Variator
glyph.Variator.desc=Allow to manually select different strength of signal
glyph.LaserDetector.name=Laser Detector
glyph.LaserDetector.desc=Detect the closest entity or block with a laser

# Transform
glyph.OrG.name=Gate: OR
glyph.OrG.desc=A binary OR gate
glyph.XOrG.name=Gate: XOR
glyph.XOrG.desc=A binary absolute OR gate
glyph.AndG.name=Gate: AND
glyph.AndG.desc=A binary AND gate, inputs not properly connected are not taken into account
glyph.NotG.name=Gate: NOT
glyph.NotG.desc=A binary NOT gate, inverting received signal
glyph.Inverter.name=Inverter
glyph.Inverter.desc=An analog gate that invert the incoming signal
glyph.Relay.name=Relay
glyph.Relay.desc=Transfer signal without altering it
glyph.Toggle.name=Toggle
glyph.Toggle.desc=Switch state from ON to OFF every pulse
glyph.PreciseInput.name=Precise Input
glyph.PreciseInput.desc=Allow to precisely set the strength of the signal
glyph.CalcSubtract.name=Math: Subtract
glyph.CalcSubtract.desc=Make a subtract operation\nA-B=C\n(A is the left input,B is the right input)
glyph.CalcAdd.name=Math: Add
glyph.CalcAdd.desc=Add the 2 inputs together\nA+B=C\n(A is the left input,B is the right input)
glyph.CalcMod.name=Math: Modulo
glyph.CalcMod.desc=Make a modulo operation\nA%B=C\n(A is the left input,B is the right input)
glyph.CalcDivide.name=Math: Divide
glyph.CalcDivide.desc=Make a divide operation\nA/B=C\n(A is the left input,B is the right input)
glyph.CalcMultiply.name=Math: Multiply
glyph.CalcMultiply.desc=Make a multiply operation\nA*B=C\n(A is the left input,B is the right input)
glyph.Delayer.name=Delayer
glyph.Delayer.desc=Replicate the input signal but with a configurable delay
glyph.Comparator.name=Comparator
glyph.Comparator.desc=Compare A to B depending of selected operation.\nSend a max strength signal if the comparison is true
glyph.BitwiseOperator.name=Bitwise
glyph.BitwiseOperator.desc=Allow to perform bit operations on A and B


# Outputs
glyph.NumberDisplay.name=Number Display
glyph.NumberDisplay.desc=Display the input strength as floating number
glyph.Fan.name=Fan
glyph.Fan.desc=Push entity in front of it with a force and distance debending on the signal's strength
glyph.Piston.name=Block Pusher
glyph.Piston.desc=Push a selected number of blocks in a row in a configurable direction.\nThe blocs pushed will be at the opposite direction of the glyph\n The distance of push is also based on signal strength.\n Unpowering the Sigil will bring the pushed blocks back
glyph.Light.name=Light
glyph.Light.desc=Emit light which strength depend on signal intensity
glyph.ColoredLight.name=Colored Light
glyph.ColoredLight.desc=Use it's 3 inputs to define the Red,Green and Blue channels of the emitted light

